# All variables are optional — only needed when you enable the matching
# integration in site.config.ts. With everything empty, the site still
# builds and renders placeholder-aware blocks.

# GitHub — pinned repos on home + contribution graph (preview on /sandbox)
# GITHUB_TOKEN=
# GITHUB_LOGIN=your-github-username

# Spotify listening card (wire your own OAuth in the API routes under
# src/app/api/spotify/ when you are ready; stubs return empty states today)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN=

# Last.fm (legacy server-side block; home Listening card uses /api/spotify/* UI)
# LASTFM_API_KEY=

# Supabase (reserved for your own routes)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sentry (reserved for your own integration)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
